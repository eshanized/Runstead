# ==============================================================================
# Runstead Environment Configuration Template (.env.example)
# Organization: Tonmoy Infrastructure
# Canonical Repository: https://github.com/eshanized/Runstead
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit actual secret keys, API tokens, or production credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub Integration & Roadmap Telemetry (/progress)
# ------------------------------------------------------------------------------
# Target repository owner/organization
GITHUB_REPO_OWNER=eshanized

# Target repository name
GITHUB_REPO_NAME=Runstead

# Optional: GitHub Personal Access Token (classic or fine-grained)
# Increases unauthenticated rate limit from 60 req/hr to 5,000 req/hr.
# Read-only repository access is sufficient. If omitted, public API is used.
GITHUB_TOKEN=
GH_TOKEN=

# In-memory progress cache TTL in seconds (default: 600 = 10 minutes)
PROGRESS_CACHE_TTL_SECONDS=600

# ------------------------------------------------------------------------------
# 2. Application Runtime & Server Settings
# ------------------------------------------------------------------------------
# Node runtime environment (development, test, production)
NODE_ENV=development

# Base URL for local development and Playwright e2e suites
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Planned Production Adapters (Phase 1+ / Milestone 4–6)
# NOTE: The following variables are reserved for upcoming production phases.
# They are not required for Phase 0 or client-side demonstration execution.
# ------------------------------------------------------------------------------

# Database Connection (Planned Phase 2 / M6: PostgreSQL / Supabase)
# DATABASE_URL=postgresql://user:password@localhost:5432/runstead?schema=public
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Payment Processing (Planned Phase 4 / M6: Stripe)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Provisioning & Infrastructure Connectors (Planned Phase 8+ / M4)
# CPANEL_WHM_HOST=
# CPANEL_WHM_USER=
# CPANEL_WHM_API_TOKEN=

# Registrar APIs (Planned Phase 12+ / M5)
# RESELLERCLUB_AUTH_USER_ID=
# RESELLERCLUB_API_KEY=
